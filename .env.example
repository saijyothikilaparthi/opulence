# Copy this file to `.env` for local development (do NOT commit `.env`)
# cp .env.example .env

# =========================
# App / Server
# =========================
APP_ENV=development
# Uvicorn local example:
# uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --env-file .env

# =========================
# Admin Console Authentication (JWT session cookie)
# =========================
# Change these before deploying anywhere public. Serve over HTTPS in production.
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=opulence
ADMIN_PASSWORD=change_this_admin_password
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=480
# Set to true when the site is served over HTTPS (required in production).
COOKIE_SECURE=false

# =========================
# Database (Local PostgreSQL)
# =========================
# Used when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gift_management
DB_USER=gift_app
DB_PASSWORD=change_this_password
DB_CONNECT_TIMEOUT=10
# Local PostgreSQL often uses disable/prefer; Supabase/production should use require.
DB_SSLMODE=prefer

# =========================
# Database (Supabase / Hosted PostgreSQL)
# =========================
# Option A (recommended): paste Supabase connection string from Dashboard:
# Project Settings -> Database -> Connection string (URI)
# Example format:
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or direct:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=
# For Supabase, set SSL to require:
# DB_SSLMODE=require

# =========================
# Media Storage (Supabase Storage)
# =========================
# Uploaded images (gallery, announcements, enquiry references) are stored in a
# public Supabase Storage bucket when these are set. Leave empty to store files
# on the local disk instead (fine for local development only).
# Dashboard -> Project Settings -> API:
SUPABASE_URL=
# Use the service_role key. Server-side only - never expose it to the browser.
SUPABASE_SERVICE_KEY=
# Bucket name. The app creates it as a public bucket on first upload if missing.
SUPABASE_STORAGE_BUCKET=media
# Image optimisation applied on upload (raster images become WebP):
IMAGE_MAX_DIMENSION=1600
IMAGE_WEBP_QUALITY=82

# =========================
# WhatsApp Admin Notifications (new enquiry)
# =========================
# Master switch: set to true after adding provider credentials.
WHATSAPP_ENABLED=false
# Provider: meta | twilio | webhook
WHATSAPP_PROVIDER=meta
# Admin recipient number (digits with country code, e.g. 918106489375).
WHATSAPP_ADMIN_TO=

# --- Meta WhatsApp Cloud API (official) ---
# Meta Developer App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
# Recommended: use an approved template for production reliability.
# If WHATSAPP_TEMPLATE_NAME is empty, code sends a plain text message (may be restricted by WhatsApp rules).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Comma-separated enquiry fields mapped to template body parameters, in order.
# Available: id,enquiry_type,name,phone,company_name,place,quantity,budget,occasion
WHATSAPP_TEMPLATE_PARAM_FIELDS=enquiry_type,name,phone,quantity,occasion,place,id

# --- Twilio WhatsApp (alternative) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Example sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# --- Generic webhook (alternative/custom gateway) ---
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# =========================
# Deployment Notes
# =========================
# - Do not commit `.env` (already in .gitignore).
# - In production, set these in your hosting provider's Environment Variables/Secrets.
# - Uploads are stored in Supabase Storage when `SUPABASE_URL` + `SUPABASE_SERVICE_KEY` are set
#   (recommended for hosts with ephemeral disks, e.g. Render free tier). Otherwise they are kept
#   in the local `uploads/` folder, which is lost on redeploy/restart on such hosts.
