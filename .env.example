# =============================================================================
#
#   OPULENCE GIFT BACKEND - ENVIRONMENT TEMPLATE
#
#   Copy this file to .env for local development:
#       cp .env.example .env
#
#   Never commit the real .env file (it is already in .gitignore).
#
#   Sections:
#       1. App / Server
#       2. Admin Console Authentication
#       3. Database - Local PostgreSQL
#       4. Database - Supabase / Hosted PostgreSQL
#       5. Media Storage - Supabase Storage
#       6. WhatsApp Admin Notifications
#       7. Deployment Notes
#
# =============================================================================



# =============================================================================
#   1. APP / SERVER
# =============================================================================

APP_ENV=development

# Local development command:
#   uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --env-file .env



# =============================================================================
#   2. ADMIN CONSOLE AUTHENTICATION (JWT session cookie)
# =============================================================================

# Change these before deploying anywhere public.
# Always serve the admin console over HTTPS in production.
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=opulence
ADMIN_PASSWORD=change_this_admin_password

# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=480

# Set to true when the site is served over HTTPS (required in production).
COOKIE_SECURE=false



# =============================================================================
#   3. DATABASE - LOCAL POSTGRESQL
# =============================================================================

# Used when DATABASE_URL is not set (see section 4).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gift_management
DB_USER=gift_app
DB_PASSWORD=change_this_password

DB_CONNECT_TIMEOUT=10

# Local PostgreSQL often uses disable/prefer;
# Supabase and other hosted databases should use require.
DB_SSLMODE=prefer



# =============================================================================
#   4. DATABASE - SUPABASE / HOSTED POSTGRESQL
# =============================================================================

# Option A (recommended): paste the connection string from the Supabase
# Dashboard -> Project Settings -> Database -> Connection string (URI).
#
# Example formats:
#   DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# When using Supabase, also set DB_SSLMODE=require.
# DB_SSLMODE=require



# =============================================================================
#   5. MEDIA STORAGE - SUPABASE STORAGE
# =============================================================================

# Uploaded images (gallery, announcements, enquiry references) are stored in a
# public Supabase Storage bucket when these are set.
#
# Leave them empty to store files on the local disk instead
# (fine for local development, lost on redeploy with ephemeral hosts).

# Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=

# Use the service_role key. Server-side only - never expose it to the browser.
SUPABASE_SERVICE_KEY=

# Bucket name. The app creates it as a public bucket on first upload if missing.
SUPABASE_STORAGE_BUCKET=media

# Image optimisation applied on upload (raster images become WebP):
IMAGE_MAX_DIMENSION=1600
IMAGE_WEBP_QUALITY=82



# =============================================================================
#   6. WHATSAPP ADMIN NOTIFICATIONS (new enquiry)
# =============================================================================

# Master switch: set to true after adding provider credentials.
WHATSAPP_ENABLED=false

# Provider: meta | twilio | webhook
WHATSAPP_PROVIDER=meta

# Admin recipient number (digits with country code, e.g. 918106489375).
WHATSAPP_ADMIN_TO=


# -----------------------------------------------------------------------------
#   Meta WhatsApp Cloud API (official)
# -----------------------------------------------------------------------------

# Meta Developer App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# Recommended: use an approved template for production reliability.
# If WHATSAPP_TEMPLATE_NAME is empty, the code sends a plain text message
# (which may be restricted by WhatsApp rules).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Comma-separated enquiry fields mapped to template body parameters, in order.
# Available: id,enquiry_type,name,phone,company_name,place,quantity,budget,occasion
WHATSAPP_TEMPLATE_PARAM_FIELDS=enquiry_type,name,phone,quantity,occasion,place,id


# -----------------------------------------------------------------------------
#   Twilio WhatsApp (alternative)
# -----------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Example sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=


# -----------------------------------------------------------------------------
#   Generic webhook (alternative/custom gateway)
# -----------------------------------------------------------------------------

WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=



# =============================================================================
#   7. DEPLOYMENT NOTES
# =============================================================================

# - Do not commit the real .env file (already in .gitignore).
# - In production, set these values in your hosting provider's
#   Environment Variables / Secrets panel.
# - Uploads are stored in Supabase Storage when SUPABASE_URL and
#   SUPABASE_SERVICE_KEY are set (recommended for hosts with ephemeral disks,
#   e.g. Render free tier). Otherwise files stay in the local uploads/ folder,
#   which is lost on redeploy or restart on such hosts.

# =============================================================================
